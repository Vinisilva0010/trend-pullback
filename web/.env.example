# Copy to .env.local for local tests. On Vercel, set these in
# Project > Settings > Environment Variables. Never commit real values.

# Password to open the dashboard (at least 12 characters).
DASHBOARD_PASSWORD=
# Random secret that signs the login cookie (at least 32 characters).
SESSION_SECRET=
# Same token as DASHBOARD_TOKEN in the tool's .env (32+ letters, digits, - or _).
INGEST_TOKEN=
# Web push keys: run `npm run vapid` once and paste the two lines it prints.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Filled in automatically when Upstash Redis is connected on Vercel.
# Locally, leave empty to use a file in .data/ instead (npm run dev, or
# LOCAL_FILE_STORE=1 with npm start). Never set LOCAL_FILE_STORE on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloud watch (optional): an outside scheduler calls /api/cron/watch every
# 15 minutes with "Authorization: Bearer CRON_SECRET" (32+ characters). It
# warns on Telegram when the computer's robot stops and checks the US stock
# triggers, stops and targets during the session. The Telegram values are
# the same as in the tool's .env.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your real US stock balance in dollars, for the share count (optional).
STOCK_ACCOUNT_USD=
