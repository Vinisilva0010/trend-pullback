# Copy to .env and fill in. Never commit .env.
TIINGO_API_TOKEN=
# Telegram alerts for `tp daily --notify` (create the bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Web dashboard (optional): its https:// address and the same token as
# INGEST_TOKEN on Vercel. Leave empty to run without the dashboard.
DASHBOARD_URL=
DASHBOARD_TOKEN=
